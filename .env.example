# Resend (https://resend.com) — used by the /about contact form Server Action.
RESEND_API_KEY=
SUPABASE_DB_PASSWORD=

# Supabase (Project Settings → API) — project URL and publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo desarrollo: IPs de la LAN desde las que se abre `npm run dev` en el móvil (ipconfig → Wi-Fi),
# separadas por comas. Ej.: DEV_ALLOWED_ORIGINS=10.0.0.16,172.26.16.1
DEV_ALLOWED_ORIGINS=
